{
  "name": "dsh-genui-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Dynamic generative UI: renders agent-generated interactive HTML cards inline and routes user interactions back to the conversation.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "package.json",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "license": "MIT",
  "author": {
    "name": "Muhammad Jessen Reinhart Sugiarto",
    "email": "jessenreinharts@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JessenReinhart/dsh-genui-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/JessenReinhart/dsh-genui-plugin/issues"
  },
  "homepage": "https://github.com/JessenReinhart/dsh-genui-plugin#readme",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "genui",
    "generative-ui"
  ]
}